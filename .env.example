# Backend (Go) environment — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# MySQL connection (Railway gives mysql://user:pass@host:port/dbname)
DATABASE_URL=mysql://user:password@host:3306/juleol

# Super-admin: the only user allowed to create events and manage any event.
ADMIN_EMAIL=you@example.com

# Shared secret between the Next.js layer and this backend. When set, mutating
# endpoints require the X-Internal-Secret header the frontend sends.
# Must match the frontend INTERNAL_API_SECRET. Generate a long random hex string.
INTERNAL_API_SECRET=change-me-to-a-long-random-hex-string
