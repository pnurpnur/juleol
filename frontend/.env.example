# Frontend (Next.js) environment — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

NEXTAUTH_SECRET=generate-a-random-string
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URL of the Go backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Super-admin email (server-side only). Must match backend ADMIN_EMAIL.
ADMIN_EMAIL=you@example.com

# Shared secret forwarded to the backend on privileged calls.
# Must match backend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=change-me-to-a-long-random-hex-string
